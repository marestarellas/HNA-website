{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "attuning-to-nature",
	"main": ".open-next/worker.js",

	// Required: this OAuth token can see more than one account, and `next dev`
	// runs wrangler non-interactively, so without this it cannot pick one and
	// the remote proxy for the AI binding fails to start. When that happens,
	// every route calling `getCloudflareContext()` returns 500 — in practice
	// that means all of /api, so pages render but their data fetches fail.
	// Static pages are unaffected, so most front-end work does not need this.
	// This is the account owning the `attuning_to_nature` D1 below.
	"account_id": "5fa5ad096d12a48d705f39a18f50c627",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// Self-reference for OpenNext caching. Service name must match `name` above.
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "attuning-to-nature"
		}
	],

	// D1 — website data (stories, questionnaire, experiment).
	// This is the LIVE database created for the map prototype; it already holds
	// the seeded myth corpus plus embeddings, projections and clusters, and has
	// migrations 0001–0013 recorded as applied. Note the underscores in the
	// name — do not "correct" them to hyphens, that would point at a database
	// which does not exist.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "attuning_to_nature",
			"database_id": "ebd731fd-86fd-4cd1-8cc0-6949eb310e73",
			"migrations_dir": "db/migrations"
		}
	],

	// R2 — incremental cache (required by OpenNext) + project buckets.
	// First run, for each: `npx wrangler r2 bucket create <bucket_name>`
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "attuning-to-nature-opennext-cache"
		},
		// Story media — voice recordings (`audio/` prefix) and pareidolia
		// photographs (`img/` prefix) share one bucket. This supersedes the
		// bootstrap's `AUDIO_BUCKET` placeholder, which nothing was written
		// against; the story routes already read and write `MEDIA`.
		{
			"binding": "MEDIA",
			"bucket_name": "attuning-to-nature-media"
		},
		{
			"binding": "STIMULI_BUCKET",
			"bucket_name": "attuning-to-nature-stimuli"
		},
		{
			"binding": "RENDERS_BUCKET",
			"bucket_name": "attuning-to-nature-renders"
		}
	],

	// Built-in Cloudflare image optimization.
	"images": {
		"binding": "IMAGES"
	},

	// Workers AI — Whisper for voice→text, bge-m3 for story embeddings, and
	// llama-3.1-8b for naming semantic clusters.
	"ai": { "binding": "AI" },

	// NOTE: there is deliberately no `vectorize` binding.
	//
	// Story resonance (GET /api/stories/:id/resonant) prefers a Vectorize index
	// when one is bound, and otherwise ranks with a cosine scan over the
	// embeddings cached in D1. Both code paths are guarded by
	// `if (env.VECTORIZE_TEXT)`, so leaving it unbound is safe, and the D1 scan
	// is perfectly adequate at the current corpus size (~115 stories).
	//
	// To turn it on later: create the index, add the binding back, and run
	// POST /api/admin/embed-backfill to populate it.
	//   npx wrangler vectorize create attuning-to-nature-text --dimensions=1024 --metric=cosine
	// Note this needs an OAuth token with the vectorize scope — the default
	// `wrangler login` scope set does not appear to include it.

	// Rate limit for POST /api/stories — 5 submissions per minute per IP.
	"unsafe": {
		"bindings": [
			{
				"name": "RL_STORIES",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 5, "period": 60 }
			}
		]
	},

	"vars": {
		"CONSENT_VERSION": "2026-05-29"
	},

	"observability": {
		"enabled": true
	}
}
