# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# MapTiler — basemap tiles for the World view on /stories
# ---------------------------------------------------------------------------
# Required to see the map. Without it the page still renders and all 115 pins
# still load from D1, but every tile style returns 403 and you get pins on a
# blank canvas. The Constellation view is unaffected: it draws no tiles.
#
# Free key: https://cloud.maptiler.com/account/keys/
#
# NEXT_PUBLIC_ means this is inlined into the client bundle and is visible to
# anyone who opens devtools — that is unavoidable for a browser-side map. Lock
# it down with an allowed-origins rule in the MapTiler dashboard rather than
# treating it as a secret.
NEXT_PUBLIC_MAPTILER_KEY=
